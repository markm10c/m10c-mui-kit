{
  "name": "@m10c/mui-kit",
  "version": "1.0.0",
  "description": "MUI-based admin UI toolkit (theme, form, components, hooks)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m10c/mui-kit.git"
  },
  "sideEffects": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "theme": [
        "./dist/theme/index.d.ts"
      ],
      "components": [
        "./dist/components/index.d.ts"
      ],
      "form": [
        "./dist/form/index.d.ts"
      ],
      "hooks": [
        "./dist/hooks/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "ts": "tsc --noEmit",
    "lint": "eslint src/",
    "pretty": "prettier --write \"src/**/*.{ts,tsx}\"",
    "pretty:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "@mui/material": ">=6.0.0",
    "@mui/x-date-pickers": ">=6.0.0",
    "date-fns": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hot-toast": ">=2.0.0",
    "react-typed-form": ">=0.3.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@eslint/js": "^9",
    "@mui/material": "^6.4.7",
    "@mui/x-date-pickers": "^6.20.0",
    "@types/react": "18",
    "@types/react-dom": "18",
    "date-fns": "^2.30.0",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-typed-form": "0.3.6",
    "tsup": "^8.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7"
  }
}
